            `Halo Bapak/Ibu ${item.namaPelapor}, kami dari Tim Verifikasi Dinas Lingkungan Hidup Kabupaten Lembata mengonfirmasi laporan Anda dengan No. Register: ${item.id} terkait dugaan ${item.jenisPencemaran} di Desa ${item.desa}, Kec. ${item.kecamatan}. Mohon informasi tambahan terkait laporan ini.`
          );
          const cleanPhone = (item.noHp || '').replace(/[^0-9]/g, '');
          const waPhone = cleanPhone.startsWith('0') ? '62' + cleanPhone.slice(1) : cleanPhone;

          return `
            <tr>
              <td>
                <span class="ticket-badge" onclick="window.portal.showDetailModal('${item.id}')" title="Klik untuk rincian lengkap">
                  ${item.id}
                </span>
              </td>
              <td>
                <span style="font-weight: 700; color: #111827; font-size: 0.8rem;">${dateOnly}</span>
                ${timeOnly ? `<div style="font-size: 0.72rem; color: #6b7280;">${timeOnly}</div>` : ''}
              </td>
              <td>
                <div style="font-weight: 700; color: #111827; font-size: 0.82rem;">${item.namaPelapor}</div>
                <div style="font-size: 0.74rem; color: #6b7280; font-family: monospace;">(${item.noHp || '-'})</div>
              </td>
              <td>
                <div style="font-weight: 600; color: #374151; font-size: 0.8rem;">${item.kecamatan}${item.desa ? ', ' + item.desa : ''}</div>
                ${mapsUrl ? `<a href="${mapsUrl}" target="_blank" style="font-size: 0.72rem; color: #0284c7; text-decoration: underline; font-weight: 600;">&#128205; GPS</a>` : ''}
              </td>
              <td>
                <span style="font-weight: 700; color: #065f46; font-size: 0.8rem;">${item.jenisPencemaran}</span>
              </td>
              <td>
                ${this.getStatusBadgeHtml(item.status)}
              </td>
              <td style="text-align: center; white-space: nowrap;">
