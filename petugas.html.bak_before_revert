      align-items: center;
      justify-content: center;
    }

    .btn-tbl-label {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1px;
    }

    .btn-tbl-detail {
      background: #f1f5f9;
      color: #1e293b;
