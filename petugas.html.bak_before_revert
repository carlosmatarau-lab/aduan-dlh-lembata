    }

    .tickets-page-summary {
      font-size: 0.76rem;
      color: #6b7280;
      font-weight: 600;
    }

    /* ===================================================================
       RIGHT COLUMN: INTERACTIVE MAP CARD (MATCHING THE SCREENSHOT)
       =================================================================== */
    .interactive-map-card {
      background: #ffffff;
      border: 1px solid #e5e7eb;
      border-radius: 16px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      height: 400px;
      min-height: 400px;
    }

    .petugas-map-canvas-eco {
      flex: 1;
      width: 100%;
      min-height: 400px;
      height: 100%;
      background: #1e293b;
      position: relative;
      z-index: 10;
    }

    /* Floating Topbar Overlay inside map */
    .map-overlay-topbar {
      position: absolute;
      top: 12px;
      left: 12px;
      right: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      z-index: 500;
      pointer-events: none;
    }

    /* 1. Live GPS Kuncian Pill: Standardized 30px Height */
    .live-gps-pill {
      pointer-events: auto;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      height: 30px;
      padding: 0 10px;
      box-sizing: border-box;
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border-radius: 6px;
      border: 1px solid rgba(203, 213, 225, 0.9);
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
      line-height: 1;
    }

    .live-dot-pulse {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #10b981;
      box-shadow: 0 0 0 2.5px rgba(16, 185, 129, 0.35);
      animation: pulseDot 1.8s infinite;
      flex-shrink: 0;
    }

    .live-gps-text {
      font-size: 0.72rem;
      font-weight: 700;
      color: #065f46;
      letter-spacing: 0.1px;
      white-space: nowrap;
    }

    /* Controls wrapper on the right side */
    .map-controls-group {
      pointer-events: auto;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    /* 2. Toggle Button Group: Satellite, Terrain, Heatmap (Seamless, compact, rounded only at ends) */
    .map-tabs-group {
      pointer-events: auto;
      display: inline-flex;
      align-items: stretch;
      height: 30px;
      padding: 0;
      margin: 0;
      gap: 0;
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border-radius: 6px;
      border: 1px solid rgba(203, 213, 225, 0.9);
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
      overflow: hidden;
      box-sizing: border-box;
    }

    .map-tabs-group .btn-map-tab {
      height: 100%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0 9px;
      margin: 0;
      border: none;
      border-right: 1px solid rgba(226, 232, 240, 0.9);
      border-radius: 0;
      background: transparent;
      color: #4b5563;
      font-size: 0.72rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.15s ease;
      white-space: nowrap;
      box-sizing: border-box;
      line-height: 1;
    }

    .map-tabs-group .btn-map-tab:first-child {
      border-top-left-radius: 5px;
      border-bottom-left-radius: 5px;
    }

    .map-tabs-group .btn-map-tab:last-child {
      border-top-right-radius: 5px;
      border-bottom-right-radius: 5px;
      border-right: none;
    }

    .map-tabs-group .btn-map-tab:hover:not(.active) {
      background: #f1f5f9;
      color: #111827;
    }

    .map-tabs-group .btn-map-tab.active {
      background: #0f4837;
      color: #ffffff;
      font-weight: 800;
      box-shadow: none;
    }

    /* 3. Standalone Fokus Lembata Button: Same 30px height, same padding */
    .btn-map-tab.btn-map-recenter,
    .btn-map-recenter {
      pointer-events: auto;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      height: 30px;
      padding: 0 10px;
      margin: 0;
      box-sizing: border-box;
      background: #ecfdf5;
      color: #065f46;
      border: 1px solid #a7f3d0;
      border-radius: 6px;
      font-size: 0.72rem;
      font-weight: 800;
      cursor: pointer;
      transition: all 0.15s ease;
      white-space: nowrap;
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
      line-height: 1;
    }

    .btn-map-tab.btn-map-recenter:hover,
    .btn-map-recenter:hover {
      background: #d1fae5;
      border-color: #6ee7b7;
      color: #047857;
      transform: translateY(-1px);
    }

    /* Map Zoom Control Position */
    .interactive-map-card .leaflet-top.leaflet-right {
      top: 56px;
      right: 14px;
    }

    .interactive-map-card .leaflet-control-zoom {
      border-radius: 8px;
      overflow: hidden;
      border: 1px solid #cbd5e1;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    }

    /* Floating Map Legend (Bottom Right) */
    .map-floating-legend {
      position: absolute;
      bottom: 18px;
      right: 18px;
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border-radius: 12px;
      border: 1px solid rgba(226, 232, 240, 0.9);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.14);
      padding: 10px 14px;
      z-index: 500;
      min-width: 120px;
    }

    .legend-header-title {
      font-size: 0.74rem;
      font-weight: 800;
      color: #111827;
      margin-bottom: 6px;
      border-bottom: 1px solid #e5e7eb;
      padding-bottom: 4px;
    }

    .legend-list-eco {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .legend-row-eco {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.72rem;
      font-weight: 600;
      color: #374151;
    }

    .legend-pin-dot {
      font-size: 0.85rem;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .legend-label-eco {
      font-size: 0.72rem;
    }

    /* Custom Leaflet Marker Styling */
    .custom-marker-pin-wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      cursor: pointer;
    }

    .custom-marker-pin {
      width: 28px;
      height: 28px;
      border-radius: 50% 50% 50% 0;
      transform: rotate(-45deg);
      background: var(--pin-bg, #059669);
      border: 2px solid #ffffff;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.35);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.2s ease;
    }

    .custom-marker-pin:hover {
      transform: rotate(-45deg) scale(1.15);
    }

    .custom-marker-icon-inner {
      transform: rotate(45deg);
      font-size: 12px;
      color: white;
    }

    .marker-pulse-ring {
      position: absolute;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: var(--pin-bg, #059669);
      opacity: 0.35;
      animation: pinPulse 2s infinite ease-out;
      pointer-events: none;
    }

    @keyframes pinPulse {
      0% { transform: scale(0.5); opacity: 0.8; }
      100% { transform: scale(1.6); opacity: 0; }
    }

    /* Modals Backdrop & Dialog */
    .modal-backdrop {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(15, 23, 42, 0.7);
      backdrop-filter: blur(5px);
      -webkit-backdrop-filter: blur(5px);
      z-index: 10000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 16px;
    }

    .modal-backdrop.show {
      display: flex;
    }

    .modal-dialog {
      background: #ffffff;
      width: 100%;
      max-width: 640px;
      max-height: 90vh;
      border-radius: 18px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      border: 1px solid var(--border);
      animation: modalFadeIn 0.2s ease-out;
    }

    @keyframes modalFadeIn {
      from {
        opacity: 0;
        transform: translateY(10px) scale(0.98);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .modal-header {
      padding: 18px 24px;
      border-bottom: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #ffffff;
    }

    .modal-title {
      font-family: 'Outfit', sans-serif;
      font-size: 1.15rem;
      font-weight: 800;
      color: #0f172a;
      margin: 0;
    }

    .modal-close {
      background: none;
      border: none;
      font-size: 1.4rem;
      cursor: pointer;
      color: #94a3b8;
      transition: color 0.2s ease;
      line-height: 1;
      padding: 4px;
    }

    .modal-close:hover {
      color: #0f172a;
    }

    .modal-body {
      padding: 24px;
      overflow-y: auto;
      max-height: calc(90vh - 140px);
    }

    .modal-footer {
      padding: 16px 24px;
      background: #f8fafc;
      border-top: 1px solid var(--border);
      display: flex;
      justify-content: flex-end;
      gap: 12px;
    }

    .form-group-modal {
      margin-bottom: 18px;
    }

    .form-label-modal {
      display: block;
      font-size: 0.82rem;
      font-weight: 700;
      color: #334155;
      margin-bottom: 6px;
    }

    .form-control-modal {
      width: 100%;
      padding: 10px 14px;
      border-radius: 10px;
      border: 1.5px solid #cbd5e1;
      font-size: 0.86rem;
      outline: none;
      transition: all 0.2s ease;
      background: #ffffff;
      color: #0f172a;
      font-family: inherit;
    }

    .form-control-modal:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.15);
    }

    .btn-modal-cancel {
      padding: 9px 18px;
      border-radius: 10px;
      background: #e2e8f0;
      border: none;
      font-size: 0.84rem;
      font-weight: 700;
      color: #475569;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn-modal-cancel:hover {
      background: #cbd5e1;
      color: #0f172a;
    }

    .btn-modal-submit {
      padding: 9px 20px;
      border-radius: 10px;
      background: #059669;
      border: none;
      font-size: 0.84rem;
      font-weight: 700;
      color: #ffffff;
      cursor: pointer;
      box-shadow: 0 2px 6px rgba(5, 150, 105, 0.3);
      transition: all 0.2s ease;
    }

    .btn-modal-submit:hover {
      background: #047857;
      box-shadow: 0 4px 10px rgba(5, 150, 105, 0.4);
    }

    .info-summary-box {
      background: #ecfdf5;
      border: 1px solid #a7f3d0;
      border-radius: 12px;
      padding: 14px 18px;
      margin-bottom: 20px;
      font-size: 0.82rem;
    }

    .info-summary-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 6px;
    }

    .info-summary-row:last-child {
      margin-bottom: 0;
    }

    .info-summary-label {
      color: #065f46;
      font-weight: 600;
    }

    .info-summary-value {
      color: #047857;
      font-weight: 800;
    }

    /* Toast Container */
    .toast-container {
      position: fixed;
      bottom: 24px;
      right: 24px;
      z-index: 12000;
      display: flex;
      flex-direction: column;
      gap: 10px;
      max-width: 380px;
    }

    .toast-item {
      background: #0f172a;
      color: #ffffff;
      padding: 12px 18px;
      border-radius: 12px;
      font-size: 0.85rem;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
      display: flex;
      align-items: center;
      gap: 10px;
      animation: toastSlide 0.25s ease-out;
    }

    .toast-item.success {
      background: #064e3b;
      border-left: 4px solid #10b981;
    }

    .toast-item.info {
      background: #0f172a;
      border-left: 4px solid #38bdf8;
    }

    .toast-item.warning {
      background: #78350f;
      border-left: 4px solid #f59e0b;
    }

    @keyframes toastSlide {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .petugas-login-page {
      min-height: 100vh;
      width: 100%;
      background: radial-gradient(circle at 50% 25%, #064e3b 0%, #022c22 60%, #0f172a 100%);
      background-attachment: fixed;
