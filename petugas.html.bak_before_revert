      getStatusBadgeHtml(status) {
        const clean = (status || 'Baru').toLowerCase();
        let cssClass = 'status-belum';
        let label = 'Belum Verifikasi';

        if (clean.includes('verif') || clean.includes('sedang')) {
          cssClass = 'status-proses';
          label = 'Diverifikasi';
        } else if (clean.includes('tindak') || clean.includes('proses') || clean.includes('penanganan')) {
          cssClass = 'status-proses';
          label = 'Dalam Proses';
        } else if (clean.includes('selesai') || clean.includes('tuntas')) {
          cssClass = 'status-selesai';
          label = 'Selesai';
        } else if (clean.includes('tolak')) {
          cssClass = 'status-tolak';
          label = 'Ditolak';
        }

        return `<span class="badge-status-pill ${cssClass}">${label}</span>`;
      }

      showToast(message, type = 'info') {
        const container = document.getElementById('toastContainer');
        if (!container) return;

        const toast = document.createElement('div');
        toast.className = `toast-item ${type}`;

        let icon = 'â„¹ï¸';
