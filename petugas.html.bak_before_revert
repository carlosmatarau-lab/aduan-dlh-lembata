    .btn-page-nav:hover {
      background: #f3f4f6;
      color: #111827;
    }

    .page-num-pill {
      min-width: 28px;
      height: 28px;
      padding: 0 8px;
      border-radius: 6px;
      border: 1px solid #e5e7eb;
      background: #ffffff;
      color: #111827;
      font-size: 0.8rem;
      font-weight: 700;
      display: flex;
      align-items: center;
