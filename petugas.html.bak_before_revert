      /* ===================================================================
         2. PETA INTERAKTIF & HEATMAP SEBARAN SPASIAL
         =================================================================== */
      initMap() {
        const container = document.getElementById('petugasMap');
        if (!container || typeof L === 'undefined') return;

        try {
          // Bounding Box Lengkap Pulau Lembata (Ujung barat Lewoleba ke timur Buyasuri, utara Tanjung Ile Ape ke selatan Wulandoni/Atadei)
          const southWest = L.latLng(-8.66, 123.28);
          const northEast = L.latLng(-8.08, 123.98);
          const lembataBounds = L.latLngBounds(southWest, northEast);
          this.centerCoords = [-8.375, 123.570]; // Titik Pusat Geografis Pulau Lembata

          this.map = L.map('petugasMap', {
            center: this.centerCoords,
            zoom: 10,
            minZoom: 9.0,
            maxZoom: 18,
            maxBounds: L.latLngBounds(L.latLng(-8.85, 123.10), L.latLng(-7.95, 124.15)),
            maxBoundsViscosity: 0.85,
            zoomControl: false,
            scrollWheelZoom: true
          });
          L.control.zoom({ position: 'topright' }).addTo(this.map);

          // Posisikan kamera presisi agar seluruh Pulau Lembata tampil utuh 100% tanpa perlu digeser
          this.map.fitBounds(lembataBounds, { padding: [14, 14] });

          // Layer Basemap (CartoDB Voyager / OSM - Bebas Blokir & Stabil)
          const osmLayer = L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
            maxZoom: 19,
            subdomains: 'abcd',
            attribution: '&copy; OpenStreetMap &bull; CARTO &bull; DLH Kab. Lembata'
          });

          const satBase = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
            maxZoom: 19,
            attribution: 'Citra Satelit &copy; Esri, Maxar'
          });
          const satLabels = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}', {
            maxZoom: 19
          });
          const satLayer = L.layerGroup([satBase, satLabels]);

          const topoLayer = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}', {
            maxZoom: 19,
            attribution: 'Topografi &copy; Esri, USGS'
          });

          satLayer.addTo(this.map);
          this.baseLayers = { osm: osmLayer, sat: satLayer, topo: topoLayer };
          this.currentBaseLayer = 'sat';

          L.control.scale({ imperial: false, position: 'bottomright' }).addTo(this.map);

          this.markersGroup = L.layerGroup().addTo(this.map);
          this.renderMapLayers();

          setTimeout(() => {
            if (this.map) {
              this.map.invalidateSize();
              this.map.fitBounds(lembataBounds, { padding: [14, 14] });
            }
          }, 350);
        } catch (err) {
          console.error('Error inisialisasi Peta Petugas:', err);
        }
      }

      renderMapLayers() {
        if (!this.map) return;

        const data = window.aduanStore ? window.aduanStore.getAll() : [];
        const filtered = data.filter(item => {
          let matchKec = true;
          if (this.mapFilters.kecamatan !== 'all') {
            matchKec = (item.kecamatan || '').toLowerCase() === this.mapFilters.kecamatan.toLowerCase();
          }

          let matchSt = true;
          if (this.mapFilters.status !== 'all') {
            const itemSt = (item.status || 'Baru').toLowerCase();
            matchSt = itemSt.includes(this.mapFilters.status.toLowerCase());
          }

          return matchKec && matchSt && item.lat && item.lng;
        });

        const summaryEl = document.getElementById('mapPointsSummary');
        if (summaryEl) {
          summaryEl.textContent = `Menampilkan ${filtered.length} titik koordinat GPS aktif di Kabupaten Lembata`;
        }

        // 1. Render Penanda Titik (Markers)
        if (this.markersGroup) {
          this.markersGroup.clearLayers();

          if (this.mapMode === 'markers' || this.mapMode === 'hybrid') {
            filtered.forEach(item => {
              const statusClean = (item.status || 'Baru').toLowerCase();
              let pinBg = '#e11d48'; // Baru
              let iconChar = '⚠️';

              if (statusClean.includes('verif')) {
                pinBg = '#f59e0b';
                iconChar = '📋';
              } else if (statusClean.includes('tindak') || statusClean.includes('proses') || statusClean.includes('penanganan')) {
                pinBg = '#2563eb';
                iconChar = '🛠️';
              } else if (statusClean.includes('selesai') || statusClean.includes('tuntas')) {
                pinBg = '#10b981';
                iconChar = '✅';
              } else if (statusClean.includes('tolak')) {
                pinBg = '#64748b';
                iconChar = '✕';
              }

              const customIcon = L.divIcon({
                className: 'custom-marker-icon-wrapper',
                html: `
                  <div class="custom-marker-pin-wrap">
                    <div class="marker-pulse-ring" style="--pin-bg: ${pinBg};"></div>
                    <div class="custom-marker-pin" style="--pin-bg: ${pinBg};">
                      <span class="custom-marker-icon-inner">${iconChar}</span>
                    </div>
                  </div>
                `,
                iconSize: [28, 28],
                iconAnchor: [14, 28],
                popupAnchor: [0, -28]
              });

              const marker = L.marker([item.lat, item.lng], { icon: customIcon });

              const popupHtml = `
                <div style="font-family: inherit; font-size: 0.82rem; min-width: 220px; line-height: 1.45;">
                  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; border-bottom: 1px solid #e2e8f0; padding-bottom: 4px;">
                    <strong style="color: #065f46; font-family: monospace;">${item.id}</strong>
                    ${this.getStatusBadgeHtml(item.status)}
                  </div>
                  <div style="font-weight: 800; color: #0f172a; margin-bottom: 2px;">${item.namaPelapor}</div>
                  <div style="color: #64748b; font-size: 0.76rem; margin-bottom: 4px;">📍 Kec. ${item.kecamatan}, Desa ${item.desa || '-'}</div>
                  <div style="color: #047857; font-weight: 700; margin-bottom: 6px;">🏷️ ${item.jenisPencemaran}</div>
                  <div style="color: #475569; font-size: 0.76rem; margin-bottom: 10px; max-height: 44px; overflow: hidden; text-overflow: ellipsis;">
                    "${(item.uraian || '').substring(0, 75)}..."
                  </div>
                  <div style="display: flex; gap: 6px;">
                    <button type="button" class="btn-tbl btn-tbl-detail" style="flex: 1; padding: 5px; font-size: 0.74rem;" onclick="window.portal.showDetailModal('${item.id}')">
                      🔍 Rincian
                    </button>
                    <button type="button" class="btn-tbl btn-tbl-verify" style="flex: 1; padding: 5px; font-size: 0.74rem;" onclick="window.portal.openVerifikasiModal('${item.id}')">
                      📋 Verifikasi
                    </button>
                  </div>
                </div>
              `;

              marker.bindPopup(popupHtml);
              this.markersGroup.addLayer(marker);
            });
          }
        }

        // 2. Render Peta Panas (Heatmap)
        if (this.heatmapLayer) {
          this.map.removeLayer(this.heatmapLayer);
          this.heatmapLayer = null;
        }

        if ((this.mapMode === 'heatmap' || this.mapMode === 'hybrid') && filtered.length > 0) {
          const heatData = filtered.map(item => {
            const st = (item.status || 'Baru').toLowerCase();
            let intensity = 0.9;
            if (st.includes('verif')) intensity = 0.75;
            else if (st.includes('tindak') || st.includes('proses')) intensity = 0.6;
            else if (st.includes('selesai')) intensity = 0.35;
            return [item.lat, item.lng, intensity];
          });

          if (typeof L.heatLayer === 'function') {
            this.heatmapLayer = L.heatLayer(heatData, {
              radius: 32,
              blur: 20,
              maxZoom: 15,
              gradient: {
                0.2: '#3b82f6',
                0.4: '#06b6d4',
                0.6: '#10b981',
                0.8: '#f59e0b',
                1.0: '#ef4444'
              }
            });
            this.heatmapLayer.addTo(this.map);
          } else {
            // Fallback Heatmap lingkaran radial transparan jika offline
            const heatFallbackGroup = L.layerGroup();
            filtered.forEach(item => {
              L.circle([item.lat, item.lng], {
                radius: 400,
                color: '#ef4444',
                fillColor: '#f97316',
                fillOpacity: 0.45,
                stroke: false
              }).addTo(heatFallbackGroup);
            });
            this.heatmapLayer = heatFallbackGroup.addTo(this.map);
          }
        }
      }

      setMapMode(mode) {
        this.mapMode = mode;
        const btnM = document.getElementById('btnModeMarkers');
        const btnH = document.getElementById('btnModeHeatmap');
        const btnY = document.getElementById('btnModeHybrid');

        if (btnM) btnM.classList.toggle('active', mode === 'markers');
        if (btnH) btnH.classList.toggle('active', mode === 'heatmap');
        if (btnY) btnY.classList.toggle('active', mode === 'hybrid');

        this.renderMapLayers();
      }

      changeBasemap(type) {
        if (!this.map || !this.baseLayers[type]) return;
        Object.values(this.baseLayers).forEach(layer => {
          if (this.map.hasLayer(layer)) this.map.removeLayer(layer);
        });
        this.baseLayers[type].addTo(this.map);
        this.currentBaseLayer = type;
      }

