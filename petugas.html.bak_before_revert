      async manualSync() {
        const btn = document.getElementById('btnManualSync');
        const icon = document.getElementById('syncIconSpin');
        if (icon) icon.style.animation = 'spin 0.8s linear infinite';
        if (btn) btn.disabled = true;

        this.showToast('🔄 Menghubungkan & mengambil data Google Spreadsheet...', 'info');

        try {
          if (window.aduanStore) {
            if (typeof window.aduanStore.mapRemoteRecord !== 'function' && typeof AduanDataStore !== 'undefined') {
              window.aduanStore.mapRemoteRecord = AduanDataStore.prototype.mapRemoteRecord.bind(window.aduanStore);
            }
            const res = await window.aduanStore.syncFromGAS(false);
            if (res && res.success) {
              const remoteCount = res.remoteCount !== undefined ? res.remoteCount : (res.count || 0);
              this.showToast(`✅ Berhasil menyinkronkan ${remoteCount} aduan dari Google Spreadsheet!`, 'success');
            } else if (res && res.error) {
              this.showToast(`Info Sinkronisasi: ${res.error}`, 'warning');
            } else {
              this.showToast('✅ Data aduan berhasil disegarkan.', 'success');
            }
          }
        } catch (e) {
          console.warn('Manual sync error:', e);
          this.showToast(`Info Sinkronisasi: ${e.message}`, 'warning');
        } finally {
          this.updateKPIs();
          this.renderTable();
          this.renderMapLayers();
          if (btn) btn.disabled = false;
          if (icon) icon.style.animation = 'none';
        }
      }

