      async pasteClipboardToWaImport() {
        const input = document.getElementById('inputWaRawText');
        if (!input) return;
        try {
          if (navigator.clipboard && navigator.clipboard.readText) {
            const text = await navigator.clipboard.readText();
            if (text && text.trim()) {
              input.value = text;
              this.parseWaText();
              this.showToast('Teks pesan WhatsApp berhasil ditempel dari clipboard.', 'success');
              return;
            }
          }
        } catch (e) {
          console.warn('Clipboard read failed:', e);
        }
        input.focus();
        this.showToast('Gunakan pintasan Ctrl+V (atau tempel manual) pada kotak teks.', 'info');
      }

      parseWaText() {
        const input = document.getElementById('inputWaRawText');
        const raw = (input ? input.value : '').trim();
        if (!raw) {
          this.showToast('Silakan tempelkan teks pesan WhatsApp terlebih dahulu.', 'warning');
          return;
        }

        // Helper regex extraction
        const clean = (val) => (val || '').replace(/[\*\_]/g, '').trim();

        // 1. Ekstrak Nomor Register (misal ADU-LMB-2026-1017-8K4F atau ADU-LMB-2026-480)
        let id = '';
        const matchId = raw.match(/NOMOR\s+REGISTER:\s*([A-Za-z0-9\-]+)/i) || raw.match(/(ADU-LMB-[A-Za-z0-9\-]+)/i);
        if (matchId && matchId[1]) {
          id = clean(matchId[1]).toUpperCase();
        } else {
          id = (window.aduanStore && typeof window.aduanStore.generateNewId === 'function')
            ? window.aduanStore.generateNewId()
            : `ADU-LMB-${new Date().getFullYear()}-${Date.now().toString(36).toUpperCase()}`;
        }

        // 2. Ekstrak Nama Pelapor
        let nama = '';
        const matchNama = raw.match(/Nama\s+Pelapor:\s*([^\n\r]+)/i);
        if (matchNama && matchNama[1]) nama = clean(matchNama[1]);
        if (!nama || nama === '-') nama = 'Masyarakat (Laporan WA)';

        // 3. Ekstrak Nomor WhatsApp / HP
        let noHp = '';
        const matchHp = raw.match(/Nomor\s+WhatsApp(?:\s*\/\s*HP)?:\s*([^\n\r]+)/i) || raw.match(/No\s*HP:\s*([^\n\r]+)/i);
        if (matchHp && matchHp[1]) noHp = clean(matchHp[1]);

        // 4. Ekstrak Alamat Domisili
        let alamat = '';
        const matchAlamat = raw.match(/Alamat\s+Domisili:\s*([^\n\r]+)/i) || raw.match(/Alamat:\s*([^\n\r]+)/i);
        if (matchAlamat && matchAlamat[1]) alamat = clean(matchAlamat[1]);

        // 5. Ekstrak Kecamatan
        let kecamatan = 'Nubatukan';
        const matchKec = raw.match(/Kecamatan:\s*([^\n\r]+)/i);
        if (matchKec && matchKec[1]) {
          const kecRaw = clean(matchKec[1]);
          const kecDict = (typeof KECAMATAN_LEMBATA !== 'undefined' ? KECAMATAN_LEMBATA : (window.KECAMATAN_LEMBATA || {}));
          const foundKec = Object.keys(kecDict).find(k => k.toLowerCase() === kecRaw.toLowerCase());
          kecamatan = foundKec || kecRaw || 'Nubatukan';
        }

        // 6. Ekstrak Desa / Kelurahan
        let desa = '';
        const matchDesa = raw.match(/Desa\s*(?:\/\s*Kelurahan)?:\s*([^\n\r]+)/i);
        if (matchDesa && matchDesa[1]) desa = clean(matchDesa[1]);

        // 7. Ekstrak Patokan Lokasi Detail
        let lokasiDetail = '';
        const matchLok = raw.match(/Patokan\s+Lokasi\s+Detail:\s*([^\n\r]+)/i) || raw.match(/Lokasi\s+Detail:\s*([^\n\r]+)/i);
        if (matchLok && matchLok[1]) lokasiDetail = clean(matchLok[1]);

        // 8. Ekstrak Titik Koordinat GPS (Dukungan URL Google Maps & Titik Satelit Presisi)
        let lat = null;
        let lng = null;
        const matchGps = raw.match(/Titik\s+Koordinat(?:\s+GPS)?:\s*(-?[0-9\.]+)\s*,\s*([0-9\.]+)/i) ||
                         raw.match(/maps\.google\.com\/(?:maps)?\?q=(-?[0-9\.]+),([0-9\.]+)/i) ||
                         raw.match(/google\.com\/maps\?q=(-?[0-9\.]+),([0-9\.]+)/i) ||
                         raw.match(/@(-?[0-9\.]+),([0-9\.]+)/i) ||
                         raw.match(/(-?8\.[0-9]+)\s*,\s*(12[3-4]\.[0-9]+)/i);
        if (matchGps && matchGps[1] && matchGps[2]) {
          lat = parseFloat(matchGps[1]);
          lng = parseFloat(matchGps[2]);
        }

        // 9. Ekstrak Jenis Pencemaran
        let jenisPencemaran = 'Pencemaran Lingkungan';
        const matchJenis = raw.match(/Jenis\s+Pencemaran:\s*([^\n\r]+)/i);
        if (matchJenis && matchJenis[1]) jenisPencemaran = clean(matchJenis[1]);

        // 10. Ekstrak Tanggal Kejadian
        let tanggalKejadian = new Date().toISOString().split('T')[0];
        const matchTgl = raw.match(/Tanggal\s+Kejadian:\s*([^\n\r]+)/i);
        if (matchTgl && matchTgl[1]) tanggalKejadian = clean(matchTgl[1]);

        // 11. Ekstrak Sumber Dugaan
        let sumberDugaan = '-';
        const matchSumber = raw.match(/Dugaan\s+Sumber:\s*([^\n\r]+)/i);
        if (matchSumber && matchSumber[1]) sumberDugaan = clean(matchSumber[1]);

        // 12. Ekstrak Uraian Kronologi
        let uraian = '';
        const matchUraian = raw.match(/URAIAN\s+KRONOLOGI:\s*([\s\S]*?)(?=(?:📸|BUKTI\s+FOTO|Status:\s*Pelapor|----------------|_Laporan|$))/i);
        if (matchUraian && matchUraian[1]) {
          uraian = clean(matchUraian[1]);
        }
        if (!uraian || uraian === '-') {
          uraian = `Pengaduan masuk dari warga via pesan WhatsApp resmi mengenai dugaan ${jenisPencemaran} di wilayah Desa ${desa || '-'}, Kecamatan ${kecamatan}.`;
        }

        const now = new Date();
        const formattedTimestamp = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')} ${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;

        // Periksa apakah ID ini sudah tercatat sebelumnya di database untuk mempertahankan seluruh foto bukti
        const existingRecord = (window.aduanStore && id) ? window.aduanStore.getById(id) : null;
        let preservedPhotos = [];
        if (existingRecord) {
          if (Array.isArray(existingRecord.buktiFotoList) && existingRecord.buktiFotoList.length > 0) {
            preservedPhotos = [...existingRecord.buktiFotoList];
          } else if (existingRecord.fotoBukti && existingRecord.fotoBukti !== '-') {
            preservedPhotos = [existingRecord.fotoBukti];
          }
        }

        this.currentParsedWaData = {
          id: id,
          timestamp: formattedTimestamp,
          namaPelapor: nama,
          noHp: noHp || '-',
          alamatPelapor: alamat || '-',
          kecamatan: kecamatan,
          desa: desa || '-',
          lokasiDetail: lokasiDetail || '-',
          lat: lat,
          lng: lng,
          jenisPencemaran: jenisPencemaran,
          uraian: uraian,
          sumberDugaan: sumberDugaan,
          tanggalKejadian: tanggalKejadian,
          status: 'Aduan Diterima',
          fotoBukti: preservedPhotos[0] || '',
          linkFotoBukti: preservedPhotos.length > 1 ? preservedPhotos.join(', ') : (preservedPhotos[0] || ''),
          buktiFotoList: preservedPhotos,
          petugasVerifikasi: '-',
          tanggalVerifikasi: '-',
          hasilVerifikasi: 'Menunggu penugasan verifikator lapangan DLH.',
          tindakanDLH: 'Aduan dicatat melalui integrasi pesan WhatsApp.',
          tanggalSelesai: '-'
        };

        // Render pratinjau foto jika ada
        const photoContainer = document.getElementById('previewWaPhotosContainer');
        if (photoContainer) {
          photoContainer.innerHTML = '';
          if (preservedPhotos.length > 0) {
            preservedPhotos.forEach((src, idx) => {
              const div = document.createElement('div');
              div.style.cssText = 'position: relative; width: 55px; height: 55px; border-radius: 6px; overflow: hidden; border: 1.5px solid #10b981; flex-shrink: 0;';
              div.innerHTML = `<img src="${src}" alt="Foto ${idx+1}" style="width: 100%; height: 100%; object-fit: cover;">`;
              photoContainer.appendChild(div);
            });
          } else {
            photoContainer.innerHTML = '<span style="font-size: 0.74rem; color: #64748b; font-style: italic;">Belum ada lampiran foto. Klik "Tambah Foto" jika ada foto dari WA.</span>';
          }
        }

        // Listener unggah foto manual pada dialog impor WA
        const inputFiles = document.getElementById('inputWaImportFiles');
        if (inputFiles && !inputFiles._hasListener) {
          inputFiles._hasListener = true;
          inputFiles.addEventListener('change', () => {
            if (inputFiles.files && inputFiles.files.length) {
              Array.from(inputFiles.files).forEach(f => {
                const reader = new FileReader();
                reader.onload = (e) => {
                  const b64 = e.target.result;
                  if (b64 && this.currentParsedWaData) {
                    if (!this.currentParsedWaData.buktiFotoList) this.currentParsedWaData.buktiFotoList = [];
                    if (!this.currentParsedWaData.buktiFotoList.includes(b64)) {
                      this.currentParsedWaData.buktiFotoList.push(b64);
                      this.currentParsedWaData.fotoBukti = this.currentParsedWaData.buktiFotoList[0];
                      this.currentParsedWaData.linkFotoBukti = this.currentParsedWaData.buktiFotoList.join(', ');
                      
                      const c = document.getElementById('previewWaPhotosContainer');
                      if (c) {
                        const div = document.createElement('div');
                        div.style.cssText = 'position: relative; width: 55px; height: 55px; border-radius: 6px; overflow: hidden; border: 1.5px solid #10b981; flex-shrink: 0;';
                        div.innerHTML = `<img src="${b64}" alt="Foto" style="width: 100%; height: 100%; object-fit: cover;">`;
                        c.appendChild(div);
                      }
                    }
                  }
                };
                reader.readAsDataURL(f);
              });
              inputFiles.value = '';
            }
          });
        }

        // Render preview card
        const preview = document.getElementById('waParsePreviewCard');
        const badge = document.getElementById('previewWaRegisterBadge');
        const pNama = document.getElementById('previewWaNama');
        const pHp = document.getElementById('previewWaHp');
        const pKec = document.getElementById('previewWaKec');
        const pDesa = document.getElementById('previewWaDesa');
        const pLokasi = document.getElementById('previewWaLokasi');
        const pGps = document.getElementById('previewWaGps');
        const pJenis = document.getElementById('previewWaJenis');
        const pTanggal = document.getElementById('previewWaTanggal');
        const pUraian = document.getElementById('previewWaUraian');
        const btnSave = document.getElementById('btnSaveWaImport');

        if (badge) badge.textContent = id;
        if (pNama) pNama.textContent = nama;
        if (pHp) pHp.textContent = noHp || '-';
        if (pKec) pKec.textContent = kecamatan;
        if (pDesa) pDesa.textContent = desa || '-';
        if (pLokasi) pLokasi.textContent = lokasiDetail || '-';
        if (pGps) pGps.textContent = (lat && lng) ? `${lat}, ${lng}` : 'Auto-center Kecamatan';
        if (pJenis) pJenis.textContent = jenisPencemaran;
        if (pTanggal) pTanggal.textContent = tanggalKejadian;
        if (pUraian) pUraian.textContent = uraian;

        if (preview) preview.style.display = 'block';
        if (btnSave) btnSave.disabled = false;
        this.showToast('✅ Format WhatsApp berhasil diurai! Periksa ringkasan lalu klik Simpan.', 'success');
      }

      async saveWaImport() {
        if (this._isSavingWaImport) return;
        this._isSavingWaImport = true;
        const btnSave = document.getElementById('btnConfirmSaveWaImport');
        if (btnSave) {
          btnSave.disabled = true;
          btnSave.innerHTML = '<span>⏳</span> Menyimpan...';
        }

        try {
          if (!this.currentParsedWaData || !window.aduanStore) {
            this.showToast('Data aduan belum siap disimpan.', 'warning');
            return;
          }

          const record = await window.aduanStore.addAduan(this.currentParsedWaData);
          this.closeAllModals();
          this.updateKPIs();
          this.renderTable();
          this.renderMapLayers();

          const recId = (record && record.id) ? record.id : (this.currentParsedWaData.id || '');
          const recNama = (record && record.namaPelapor) ? record.namaPelapor : (this.currentParsedWaData.namaPelapor || '');
          this.showToast(`🎉 Aduan ${recId} atas nama "${recNama}" berhasil dicatat ke sistem!`, 'success');
        } finally {
          this._isSavingWaImport = false;
          if (btnSave) {
            btnSave.disabled = false;
            btnSave.innerHTML = '<span>💾</span> Simpan Aduan ke Database';
          }
        }

        // Focus & highlight baris di tabel jika ada
        setTimeout(() => {
          if (recId) {
            const row = document.querySelector(`[data-id="${recId}"]`);
            if (row) {
              row.scrollIntoView({ behavior: 'smooth', block: 'center' });
              row.style.background = '#ecfdf5';
              setTimeout(() => { row.style.background = ''; }, 3000);
            }
          }
        }, 400);
      }
    }

    // Inisialisasi Handal (Mendukung DOMContentLoaded & readyState Interactive / Complete)
    function startPetugasPortal() {
      if (!window.portal) {
        window.portal = new PetugasPortal();
        window.portal.init();
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', startPetugasPortal);
    } else {
      startPetugasPortal();
    }
  </script>

</body>

</html>
