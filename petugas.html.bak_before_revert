      formatPhotoUrl(src) {
        if (!src || typeof src !== 'string') return '';
        let clean = src.trim();
        if (clean.startsWith('=HYPERLINK')) {
          const m = clean.match(/=HYPERLINK\("([^"]+)"/i);
          if (m) clean = m[1];
        }
        if (clean.includes('Buka') && clean.includes('Foto Bukti')) return '';
        if (clean.startsWith('📸')) return '';
        if (clean.startsWith('data:image')) return clean;
        const driveMatch = clean.match(/(?:\/file\/d\/|[?&]id=)([a-zA-Z0-9_-]+)/);
        if (driveMatch && driveMatch[1]) {
          return `https://drive.google.com/thumbnail?id=${driveMatch[1]}&sz=w1200`;
        }
        if (clean.startsWith('http')) return clean;
        return '';
      }

      /* ===================================================================
         4. MODAL VERIFIKASI: UPLOAD FOTO FISIK RIIL & BERITA ACARA
         =================================================================== */
      setupPhotoUploadUI() {
        const fileInput = document.getElementById('vFotoRiilInput');
        const camInput = document.getElementById('vFotoKameraInput');
        const animCard = document.getElementById('vUploadAnimCard');
        const animTitle = document.getElementById('vUploadAnimTitle');
        const animStep = document.getElementById('vUploadAnimStep');
        const animPercent = document.getElementById('vUploadAnimPercent');
        const progressFill = document.getElementById('vUploadProgressFill');
        const successBanner = document.getElementById('vUploadSuccessBanner');
        const successDesc = document.getElementById('vUploadSuccessDesc');

        let vUploadTimer = null;
        const triggerOfficerUploadAnimation = (count, onDone) => {
          if (!animCard) {
            if (onDone) onDone();
            return;
          }
          if (vUploadTimer) clearInterval(vUploadTimer);
          if (successBanner) successBanner.style.display = 'none';

          animCard.style.display = 'block';
          let progress = 0;
          if (animPercent) animPercent.textContent = '0%';
          if (progressFill) progressFill.style.width = '0%';
          if (animTitle) animTitle.textContent = `Mengunggah & Memproses ${count} Foto Lapangan...`;
          if (animStep) animStep.textContent = 'Menghubungkan berkas...';

          const startTime = Date.now();
          const totalDuration = 2000;

          vUploadTimer = setInterval(() => {
            const elapsed = Date.now() - startTime;
            progress = Math.min(100, Math.round((elapsed / totalDuration) * 100));
            if (progressFill) progressFill.style.width = `${progress}%`;
            if (animPercent) animPercent.textContent = `${progress}%`;

            if (progress < 30) {
              if (animStep) animStep.textContent = '📥 Membaca data gambar dari kamera/galeri...';
            } else if (progress < 70) {
              if (animStep) animStep.textContent = '⚙️ Mengompresi resolusi Berita Acara (WebP/JPEG)...';
            } else if (progress < 95) {
              if (animStep) animStep.textContent = '🔒 Mengunci metadata foto fisik verifikator DLH...';
            } else {
              if (animStep) animStep.textContent = '✅ Memvalidasi kelengkapan dokumen foto...';
            }

            if (progress >= 100) {
              clearInterval(vUploadTimer);
              vUploadTimer = null;
              setTimeout(() => {
                animCard.style.display = 'none';
                if (successBanner) {
                  successBanner.style.display = 'flex';
                  if (successDesc) {
                    successDesc.textContent = `${this.tempUploadedPhotos.length} foto kondisi riil berhasil diunggah dengan status sukses.`;
                  }
                }
                this.showToast(`✅ ${count} Foto kondisi riil berhasil diunggah! Status: Sukses.`, 'success');
                if (onDone) onDone();
              }, 250);
            }
          }, 40);
        };

        const handleFiles = (files) => {
          if (!files || files.length === 0) return;
          const incoming = Array.from(files);
          let loaded = 0;

          triggerOfficerUploadAnimation(incoming.length, () => {
            this.renderPhotoPreviews();
          });

          incoming.forEach(file => {
            if (!file.type.startsWith('image/')) return;
            const reader = new FileReader();
            reader.onload = (e) => {
              if (e.target && e.target.result) {
                const dataUrl = e.target.result;
                const img = new Image();
                img.onload = () => {
                  try {
                    const canvas = document.createElement('canvas');
                    let width = img.width || 640;
                    let height = img.height || 480;
                    const maxDim = 720;
                    if (width > maxDim || height > maxDim) {
                      if (width > height) {
                        height = Math.round((height * maxDim) / width);
                        width = maxDim;
                      } else {
                        width = Math.round((width * maxDim) / height);
                        height = maxDim;
                      }
                    }
                    canvas.width = width;
                    canvas.height = height;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, width, height);
                    this.tempUploadedPhotos.push(canvas.toDataURL('image/jpeg', 0.65));
                  } catch (err) {
                    this.tempUploadedPhotos.push(dataUrl);
                  }
                  loaded++;
                  this.renderPhotoPreviews();
                };
                img.onerror = () => {
                  this.tempUploadedPhotos.push(dataUrl);
                  loaded++;
                  this.renderPhotoPreviews();
                };
                img.src = dataUrl;
              }
            };
            reader.readAsDataURL(file);
          });
        };

        if (fileInput) {
          fileInput.addEventListener('change', (e) => handleFiles(e.target.files));
        }
        if (camInput) {
          camInput.addEventListener('change', (e) => handleFiles(e.target.files));
        }
      }

      renderPhotoPreviews() {
        const grid = document.getElementById('vFotoPreviewGrid');
        const hint = document.getElementById('vFotoCountHint');
        const btnClear = document.getElementById('vBtnClearPhotos');
        const successBanner = document.getElementById('vUploadSuccessBanner');
        const successDesc = document.getElementById('vUploadSuccessDesc');
        if (!grid) return;

        if (this.tempUploadedPhotos.length === 0) {
          grid.innerHTML = '';
          if (hint) hint.style.display = 'none';
          if (btnClear) btnClear.style.display = 'none';
          if (successBanner) successBanner.style.display = 'none';
          return;
        }

        grid.innerHTML = this.tempUploadedPhotos.map((src, idx) => `
          <div class="preview-thumb-box">
            <span class="thumb-badge-success">✓ Sukses</span>
            <img src="${this.formatPhotoUrl(src)}" alt="Foto Fisik ${idx + 1}" onerror="this.src='${src}';">
            <button type="button" class="btn-remove-thumb" onclick="window.portal.removeUploadedPhoto(${idx})" title="Hapus foto">&times;</button>
          </div>
        `).join('');

        if (hint) {
          hint.style.display = 'block';
          hint.textContent = `✅ ${this.tempUploadedPhotos.length} foto kondisi riil terlampir untuk Berita Acara.`;
        }
        if (btnClear) {
          btnClear.style.display = 'inline-flex';
        }
        if (successBanner && successDesc) {
          successDesc.textContent = `${this.tempUploadedPhotos.length} foto kondisi riil berhasil diunggah dengan status sukses.`;
        }
      }

      clearAllUploadedPhotos() {
        this.tempUploadedPhotos = [];
        this.renderPhotoPreviews();
        const successBanner = document.getElementById('vUploadSuccessBanner');
        if (successBanner) successBanner.style.display = 'none';
        this.showToast('Semua foto kondisi riil petugas berhasil dikosongkan dari formulir.', 'info');
      }

      removeUploadedPhoto(idx) {
        this.tempUploadedPhotos.splice(idx, 1);
