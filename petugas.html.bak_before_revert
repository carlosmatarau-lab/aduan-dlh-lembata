    }

    .btn-tbl-wa {
      background: #25d366;
      color: #ffffff;
      border-color: #16a34a;
    }

    .btn-tbl-wa:hover {
      background: #16a34a;
      transform: translateY(-1px);
      box-shadow: 0 2px 4px rgba(22, 163, 74, 0.2);
    }

    .btn-tbl-del {
      background: #fff1f2;
      color: #be123c;
      border-color: #fecdd3;
    }

    .btn-tbl-del:hover {
      background: #fee2e2;
      color: #9f1239;
      border-color: #fca5a5;
      transform: translateY(-1px);
      box-shadow: 0 2px 4px rgba(225, 29, 72, 0.12);
