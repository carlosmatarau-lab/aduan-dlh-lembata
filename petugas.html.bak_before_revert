      openVerifikasiModal(id) {
        const item = window.aduanStore.getById(id);
        if (!item) return;

        const modal = document.getElementById('modalVerifikasiPetugas');
        if (!modal) return;

        document.getElementById('vTargetId').value = item.id;
        document.getElementById('vAduanId').textContent = item.id;
        document.getElementById('vNamaPelapor').textContent = item.namaPelapor;
        document.getElementById('vLokasi').textContent = `Kec. ${item.kecamatan}, Desa ${item.desa || '-'}`;
        document.getElementById('vJenisPencemaran').textContent = item.jenisPencemaran;

        // Set form fields
        document.getElementById('vStatusSelect').value = item.status || 'Diverifikasi';
        document.getElementById('vPetugasInput').value = (item.petugasVerifikasi && item.petugasVerifikasi !== '-') ? item.petugasVerifikasi : 'Tim Verifikasi Lapangan DLH Lembata';
        document.getElementById('vTanggalVerifikasi').value = item.tanggalVerifikasi || new Date().toISOString().split('T')[0];
        document.getElementById('vHasilVerifikasi').value = item.hasilVerifikasi && item.hasilVerifikasi !== '-' ? item.hasilVerifikasi : '';
        document.getElementById('vTindakanDLH').value = item.tindakanDLH && item.tindakanDLH !== '-' ? item.tindakanDLH : '';
        document.getElementById('vTanggalSelesai').value = item.tanggalSelesai && item.tanggalSelesai !== '-' ? item.tanggalSelesai : '';

        // Berita Acara & Foto Fisik
        const isUnverified = (!item.status || item.status === 'Baru' || item.status === 'Aduan Diterima' || item.status === 'Verifikasi Administrasi');
