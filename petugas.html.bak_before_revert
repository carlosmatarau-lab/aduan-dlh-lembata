    #dashboardAppWrapper {
      width: 100%;
      min-height: 100vh;
      display: none;
      flex-direction: column;
    }

    .auth-card {
      background: #ffffff;
      border-radius: 24px;
      padding: 34px 28px;
      max-width: 440px;
      width: 100%;
      box-shadow: 0 25px 60px -12px rgba(0, 0, 0, 0.5), 0 0 35px rgba(5, 150, 105, 0.18);
      border: 1.5px solid rgba(16, 185, 129, 0.3);
      text-align: center;
      position: relative;
      overflow: hidden;
      transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
      animation: authCardIn 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes authCardIn {
      0% { opacity: 0; transform: scale(0.92) translateY(20px); }
      100% { opacity: 1; transform: scale(1) translateY(0); }
    }

    .auth-card.shaking {
      animation: authShake 0.45s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
      border-color: #f43f5e;
      box-shadow: 0 25px 60px -12px rgba(225, 29, 72, 0.35), 0 0 30px rgba(225, 29, 72, 0.25);
    }

    @keyframes authShake {
      10%, 90% { transform: translate3d(-4px, 0, 0); }
      20%, 80% { transform: translate3d(6px, 0, 0); }
      30%, 50%, 70% { transform: translate3d(-7px, 0, 0); }
      40%, 60% { transform: translate3d(7px, 0, 0); }
    }

    .auth-card.unlocking {
      animation: authUnlock 0.55s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes authUnlock {
      0% { transform: scale(1); }
