          card.classList.remove('scanning');
          card.classList.add('unlocking');
        }

        setTimeout(() => {
          sessionStorage.setItem('dlh_petugas_auth', 'true');
          if (rememberCheck && rememberCheck.checked) {
            localStorage.setItem('dlh_petugas_remember', 'true');
          }
          if (loginPage) loginPage.style.display = 'none';
          if (dashWrap) dashWrap.style.display = 'flex';

          if (card) {
            card.classList.remove('unlocking', 'scanning');
          }
          if (submitBtn) submitBtn.disabled = false;
          if (btnIcon) btnIcon.textContent = '🔓';
          if (btnText) btnText.textContent = 'Buka Dashboard Petugas';
          if (badgeIcon) badgeIcon.textContent = '🛡️';

          this.showToast('🔓 Akses Berhasil: Selamat bertugas di Dashboard Petugas DLH Lembata!', 'success');

