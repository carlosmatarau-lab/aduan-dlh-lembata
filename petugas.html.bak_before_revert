    .pagination-eco-pills {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .btn-page-nav {
      width: 28px;
      height: 28px;
      border-radius: 6px;
      border: 1px solid #e5e7eb;
      background: #ffffff;
      color: #6b7280;
