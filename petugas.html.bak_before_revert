      prevPage() {
        if (this.currentPage > 1) {
          this.currentPage--;
          this.renderTable();
        }
      }

      nextPage() {
        const data = window.aduanStore ? window.aduanStore.getAll() : [];
        const maxPage = Math.max(1, Math.ceil(data.length / (this.pageSize || 10)));
        if (this.currentPage < maxPage) {
          this.currentPage++;
          this.renderTable();
        }
      }

      switchMapTab(tab) {
        document.querySelectorAll('.btn-map-tab').forEach(b => b.classList.remove('active'));
        const activeBtn = document.getElementById('btnMapTab_' + tab);
        if (activeBtn) activeBtn.classList.add('active');

        if (tab === 'satellite') {
          this.changeBasemap('sat');
          this.setMapMode('markers');
        } else if (tab === 'terrain') {
          this.changeBasemap('topo');
          this.setMapMode('markers');
        } else if (tab === 'heatmap') {
          this.setMapMode('heatmap');
        }

        if (this.map) {
          setTimeout(() => {
            try { this.map.invalidateSize(); } catch (e) {}
          }, 150);
        }
      }

      renderTable() {
        const tbody = document.getElementById('aduanTableBody');
        if (!tbody) return;

        const data = window.aduanStore ? [...window.aduanStore.getAll()] : [];

        // Urutkan laporan terbaru di paling atas
        data.sort((a, b) => {
          const parseTime = (str) => {
            if (!str) return 0;
            const t = new Date(str).getTime();
            return isNaN(t) ? 0 : t;
          };
          const tA = parseTime(a.timestamp) || parseTime(a.tanggalKejadian);
          const tB = parseTime(b.timestamp) || parseTime(b.tanggalKejadian);
          return tB - tA;
        });

        const filtered = data.filter(item => {
          // Filter Search
          const q = (this.filters.search || '').toLowerCase();
          const matchSearch = !q ||
            (item.id && item.id.toLowerCase().includes(q)) ||
            (item.namaPelapor && item.namaPelapor.toLowerCase().includes(q)) ||
            (item.kecamatan && item.kecamatan.toLowerCase().includes(q)) ||
            (item.desa && item.desa.toLowerCase().includes(q)) ||
            (item.jenisPencemaran && item.jenisPencemaran.toLowerCase().includes(q)) ||
            (item.uraian && item.uraian.toLowerCase().includes(q)) ||
            (item.noHp && item.noHp.includes(q));

          // Filter Status
          const st = this.filters.status || 'all';
          let matchStatus = true;
          if (st !== 'all') {
            const itemSt = (item.status || 'Baru').toLowerCase();
            matchStatus = itemSt.includes(st.toLowerCase());
          }

          // Filter Kecamatan
          const kec = this.filters.kecamatan || 'all';
          let matchKecamatan = true;
          if (kec !== 'all') {
            matchKecamatan = (item.kecamatan || '').toLowerCase() === kec.toLowerCase();
          }

          return matchSearch && matchStatus && matchKecamatan;
        });

        if (data.length === 0) {
          tbody.innerHTML = `
            <tr>
              <td colspan="7" style="text-align: center; padding: 40px 20px; color: #64748b;">
                <div style="font-size: 2rem; margin-bottom: 8px;">&#10024;</div>
                <strong style="color: #0f172a; font-size: 0.95rem;">Belum ada aduan masuk (0 Aduan).</strong>
                <p style="font-size: 0.8rem; color: #64748b; margin-top: 4px;">Sistem telah disegarkan dan bersih total. Siap menerima laporan baru dari formulir warga maupun WhatsApp.</p>
              </td>
            </tr>
          `;
          const footer = document.getElementById('tablePagination');
          if (footer) footer.textContent = `Menampilkan 0 dari 0 aduan`;
          const pageEl = document.getElementById('paginationCurrentPage');
          if (pageEl) pageEl.textContent = '1';
          return;
        }

        if (filtered.length === 0) {
          tbody.innerHTML = `
            <tr>
              <td colspan="7" style="text-align: center; padding: 36px 20px; color: #64748b;">
                <div style="font-size: 1.8rem; margin-bottom: 6px;">&#128237;</div>
                <strong style="color: #334155; font-size: 0.9rem;">Tidak ada data aduan yang sesuai filter.</strong>
                <p style="font-size: 0.78rem; margin-top: 3px;">Coba ubah kata kunci pencarian atau reset filter.</p>
              </td>
            </tr>
          `;
          const footer = document.getElementById('tablePagination');
          if (footer) footer.textContent = `Menampilkan 0 dari total ${data.length} aduan`;
          return;
        }

        // Pagination Calculation
        const pageSize = this.pageSize || 10;
        const totalItems = filtered.length;
        const totalPages = Math.max(1, Math.ceil(totalItems / pageSize));
        if (this.currentPage > totalPages) this.currentPage = totalPages;
        if (this.currentPage < 1) this.currentPage = 1;

        const startIndex = (this.currentPage - 1) * pageSize;
        const pageItems = filtered.slice(startIndex, startIndex + pageSize);

        const pageEl = document.getElementById('paginationCurrentPage');
        if (pageEl) pageEl.textContent = String(this.currentPage);

        const formatAduanDate = (raw) => {
          if (!raw || raw === '-') return { date: '-', time: '' };
          try {
            const d = new Date(raw);
            if (!isNaN(d.getTime())) {
              const pad = (n) => String(n).padStart(2, '0');
              const dateStr = `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
              const timeStr = `${pad(d.getHours())}:${pad(d.getMinutes())}`;
              return { date: dateStr, time: timeStr };
            }
          } catch(e) {}
          const parts = String(raw).split(' ');
          return { date: parts[0] || raw, time: parts[1] || '' };
        };

        tbody.innerHTML = pageItems.map(item => {
          const dt = formatAduanDate(item.timestamp || item.tanggalKejadian);
          const dateOnly = dt.date;
          const timeOnly = dt.time;
          const mapsUrl = (item.lat && item.lng) ? `https://maps.google.com/?q=${item.lat},${item.lng}` : '';

